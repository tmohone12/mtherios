{
	"name": "mtherios",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "node server.js",
		"app": "npm run app:dev",
		"app:dev": "npm run backend:up && npm run backend:migrate && node server.js --dev",
		"app:start": "node server.js",
		"app:build": "npm run build && node server.js",
		"engine": "npm run app:dev",
		"app:status": "node scripts/app-status.mjs",
		"app:jobs": "node scripts/app-jobs.mjs",
		"app:engine": "node scripts/app-engine.mjs",
		"app:story": "node scripts/app-story.mjs",
		"app:database": "node scripts/app-database.mjs",
		"app:agent": "node scripts/app-agent.mjs",
		"app:mcp": "node scripts/mtherios-mcp.mjs",
		"app:wiki": "node scripts/app-wiki.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"backend:up": "docker compose -p mtherios-factions up -d mtherios-db qdrant",
		"backend:down": "docker compose -p mtherios-factions down",
		"backend:migrate": "node scripts/db-migrate.mjs",
		"backend:health": "node scripts/db-health.mjs",
		"dev:backend": "npm run backend:up && npm run backend:migrate && vite dev --host 127.0.0.1",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.mjs",
		"wiki:init": "node scripts/wiki-core/init.mjs",
		"wiki:index": "node scripts/wiki-core/index.mjs",
		"wiki:ingest": "node scripts/wiki-core/ingest.mjs",
		"wiki:pages": "node scripts/wiki-core/pages.mjs",
		"wiki:search": "node scripts/wiki-core/search.mjs",
		"wiki:context": "node scripts/wiki-core/context.mjs",
		"wiki:brief": "node scripts/wiki-core/brief.mjs",
		"wiki:follow": "node scripts/wiki-core/follow.mjs",
		"wiki:page": "node scripts/wiki-core/page.mjs",
		"wiki:write": "node scripts/wiki-core/write.mjs",
		"wiki:lint": "node scripts/wiki-core/lint.mjs",
		"bench:generation": "node scripts/bench-generation.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.9.1",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.2.1",
		"@types/dompurify": "^3.0.5",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"dexie": "^4.3.0",
		"dompurify": "^3.4.1",
		"drizzle-orm": "^0.45.2",
		"google-auth-library": "^10.6.2",
		"gpt-tokenizer": "^3.4.0",
		"jszip": "^3.10.1",
		"lucide-svelte": "^0.577.0",
		"marked": "^17.0.4",
		"postgres": "^3.4.9",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	}
}
