{
	"name": "mtherios",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"backend:up": "docker compose up -d mtherios-db",
		"backend:down": "docker compose down",
		"backend:migrate": "node scripts/db-migrate.mjs",
		"backend:health": "node scripts/db-health.mjs",
		"dev:backend": "npm run backend:up && npm run backend:migrate && vite dev --host 127.0.0.1",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.58",
		"@ai-sdk/openai": "^3.0.41",
		"@ai-sdk/openai-compatible": "^2.0.35",
		"@openrouter/ai-sdk-provider": "^2.2.5",
		"@tailwindcss/vite": "^4.2.1",
		"@types/dompurify": "^3.0.5",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"dexie": "^4.3.0",
		"dompurify": "^3.4.1",
		"drizzle-orm": "^0.45.2",
		"gpt-tokenizer": "^3.4.0",
		"jszip": "^3.10.1",
		"lucide-svelte": "^0.577.0",
		"marked": "^17.0.4",
		"postgres": "^3.4.9",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	}
}
