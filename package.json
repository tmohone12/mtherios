{
	"name": "mythengine",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": { "node": ">=22.19.0" },
	"scripts": {
		"start": "node server.js",
		"app": "npm run app:dev",
		"app:dev": "npm run backend:up && npm run backend:migrate && node server.js --dev",
		"app:start": "node server.js",
		"app:build": "npm run build && node server.js",
		"engine": "npm run app:dev",
		"app:status": "node scripts/app-status.mjs",
		"app:jobs": "node scripts/app-jobs.mjs",
		"app:engine": "node scripts/app-engine.mjs",
		"app:story": "node scripts/app-story.mjs",
		"app:database": "node scripts/app-database.mjs",
		"app:agent": "node scripts/app-agent.mjs",
		"app:mcp": "node scripts/mythengine-mcp.mjs",
		"app:wiki": "node scripts/app-wiki.mjs",
		"dev": "vite dev",
		"build": "node scripts/build.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"backend:up": "node scripts/backend.mjs up",
		"backend:down": "node scripts/backend.mjs down",
		"backend:migrate": "node scripts/db-migrate.mjs",
		"backend:health": "node scripts/db-health.mjs",
		"dev:backend": "npm run app:dev",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.mjs",
		"wiki:init": "node scripts/wiki-core/init.mjs",
		"wiki:index": "node scripts/wiki-core/index.mjs",
		"wiki:ingest": "node scripts/wiki-core/ingest.mjs",
		"wiki:pages": "node scripts/wiki-core/pages.mjs",
		"wiki:search": "node scripts/wiki-core/search.mjs",
		"wiki:context": "node scripts/wiki-core/context.mjs",
		"wiki:brief": "node scripts/wiki-core/brief.mjs",
		"wiki:follow": "node scripts/wiki-core/follow.mjs",
		"wiki:page": "node scripts/wiki-core/page.mjs",
		"wiki:write": "node scripts/wiki-core/write.mjs",
		"bench:generation": "node scripts/bench-generation.mjs",
		"bench:memory": "node scripts/bench-memory.mjs",
		"eval:turns": "node scripts/eval-turns.mjs",
		"qualify:campaign": "node scripts/test-campaign-persistence.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"app:config": "node server.js --print-config",
		"backend:config": "node scripts/backend.mjs config",
		"test:runtime": "node --test scripts/runtime-config.test.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.9.1",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.0.0",
		"@earendil-works/pi-ai": "1.0.0",
		"@tailwindcss/vite": "^4.2.1",
		"dexie": "^4.3.0",
		"dompurify": "^3.4.1",
		"drizzle-orm": "^0.45.2",
		"google-auth-library": "^10.6.2",
		"gpt-tokenizer": "^3.4.0",
		"jszip": "^3.10.1",
		"lucide-svelte": "^0.577.0",
		"marked": "^17.0.4",
		"postgres": "^3.4.9",
		"tailwindcss": "^4.2.1",
		"zod": "^4.3.6"
	}
}
